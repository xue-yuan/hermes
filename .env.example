# hermes-web 的設定。複製成 .env 再填；.env 不會進 git。

# Google Cloud 主控台建立的 OAuth 用戶端 ID（網頁應用程式），例如 1234-abcd.apps.googleusercontent.com
HERMES_GOOGLE_CLIENT_ID=

# 可以登入的 Google 帳號，多個用逗號分隔
HERMES_ALLOWED_EMAILS=

# 簽署登入 token 用，至少 32 個字元；產生一次之後固定用同一個，換掉就要重新登入
# 產生方式：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HERMES_SESSION_SECRET=

# 本機用 http，refresh token 的 cookie 不限 HTTPS（不設的話 Safari 不會存，重新整理就登出）
HERMES_INSECURE_COOKIE=1

# 選填：access token 有效分鐘數（預設 15）、refresh token 幾小時沒用就過期（預設 168）
# HERMES_ACCESS_MINUTES=15
# HERMES_REFRESH_HOURS=168
